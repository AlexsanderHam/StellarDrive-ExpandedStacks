<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net48</TargetFramework>
		<RootNamespace>ExpandedStacks</RootNamespace>
		<AssemblyName>ExpandedStacks</AssemblyName>

		<Version>1.0.0</Version>

		<NeutralLanguage>en-US</NeutralLanguage>
		<LangVersion>latest</LangVersion>

		<Nullable>disable</Nullable>
	</PropertyGroup>

	<ItemGroup>
		<Reference Include="MelonLoader">
			<HintPath>libs\MelonLoader.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="0Harmony">
			<HintPath>libs\0Harmony.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="UnityEngine.CoreModule">
			<HintPath>libs\UnityEngine.CoreModule.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="Items.Model">
			<HintPath>libs\Items.Model.dll</HintPath>
			<Private>False</Private>
		</Reference>
	</ItemGroup>
	
	<Target Name="PostBuild" AfterTargets="PostBuildEvent" Condition="Exists('c:\Program Files (x86)\Steam\steamapps\common\StellarDrive Demo\Mods')">
		<Exec Command="COPY &quot;$(TargetPath)&quot; &quot;c:\Program Files (x86)\Steam\steamapps\common\StellarDrive Demo\Mods&quot;" ContinueOnError="true" />
	</Target>
</Project>